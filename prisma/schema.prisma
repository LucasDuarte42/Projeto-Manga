generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String?

  mangas              Manga[]
  passwordResetTokens PasswordResetToken[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum CollectionType {
  MANGA
  HQ
}

enum MangaStatus {
  READ
  READING
  WANT_TO_READ
}

model Manga {
  id             String         @id @default(cuid())
  name           String
  author         String?
  volume         Int
  totalVolumes   Int?
  ownedVolumes   Int[]          @default([])
  status         MangaStatus    @default(WANT_TO_READ)
  collectionType CollectionType @default(MANGA)
  note           Float?         @map("rating")
  genre          String?
  coverUrl       String?

  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  volumeRatings  VolumeRating[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, name, volume])
}

model VolumeRating {
  id        String   @id @default(cuid())
  mangaId   String
  volume    Int
  note      Float

  manga     Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@unique([mangaId, volume])
}