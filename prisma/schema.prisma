generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  name     String?
  avatarUrl String?
  featuredMangaIds String[] @default([])

  mangas              Manga[]
  passwordResetTokens PasswordResetToken[]
  collectionShares    CollectionShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CollectionShare {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

enum CollectionType {
  MANGA
  HQ
}

enum MangaStatus {
  READ
  READING
  WANT_TO_READ
}

enum VolumeStatus {
  MISSING
  OWNED
  READ
  LOANED
}

model Manga {
  id             String         @id @default(cuid())
  name           String
  author         String?
  volume         Int
  totalVolumes   Int?
  ownedVolumes   Int[]          @default([])
  totalChapters  Int?
  readChapters   Int[]          @default([])
  status         MangaStatus    @default(WANT_TO_READ)
  isInWishlist   Boolean        @default(false)
  collectionType CollectionType @default(MANGA)
  note           Float?         @map("rating")
  genre          String?
  coverUrl       String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  volumeRatings  VolumeRating[]
  chapterRatings ChapterRating[]
  volumes        MangaVolume[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name, volume])
}

model MangaVolume {
  id        String       @id @default(cuid())
  mangaId   String
  number    Int
  status    VolumeStatus @default(MISSING)
  loanedTo  String?
  loanedAt  DateTime?
  dueDate   DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  manga   Manga           @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  history VolumeHistory[]

  @@unique([mangaId, number])
  @@index([mangaId, status])
}

model VolumeHistory {
  id         String        @id @default(cuid())
  volumeId   String
  fromStatus VolumeStatus?
  toStatus   VolumeStatus
  loanedTo   String?
  dueDate    DateTime?
  changedAt  DateTime      @default(now())

  volume MangaVolume @relation(fields: [volumeId], references: [id], onDelete: Cascade)

  @@index([volumeId, changedAt])
}

model VolumeRating {
  id      String @id @default(cuid())
  mangaId String
  volume  Int
  note    Float

  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@unique([mangaId, volume])
}

model ChapterRating {
  id      String @id @default(cuid())
  mangaId String
  chapter Int
  note    Float

  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@unique([mangaId, chapter])
}
