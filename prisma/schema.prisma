generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  name     String?
  avatarUrl String?
  featuredMangaIds String[] @default([])

  mangas              Manga[]
  mangaRequests       MangaRequest[]
  passwordResetTokens PasswordResetToken[]
  collectionShares    CollectionShare[]
  reviews             MangaReview[]
  reviewLikes        ReviewLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CollectionShare {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

enum CollectionType {
  MANGA
  HQ
}

enum MangaStatus {
  READ
  READING
  WANT_TO_READ
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VolumeStatus {
  MISSING
  OWNED
  READ
  LOANED
}

model CatalogManga {
  id             String         @id @default(cuid())
  name           String
  normalizedName  String
  author         String?
  totalVolumes   Int?
  totalChapters  Int?
  genre          String?
  coverUrl       String?
  collectionType CollectionType @default(MANGA)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  mangas         Manga[]

  @@unique([normalizedName, collectionType])
  @@index([name])
}

model Manga {
  id             String         @id @default(cuid())
  name           String
  author         String?
  volume         Int
  totalVolumes   Int?
  ownedVolumes   Int[]          @default([])
  totalChapters  Int?
  readChapters   Int[]          @default([])
  status         MangaStatus?
  isInWishlist   Boolean        @default(false)
  isFavorite     Boolean        @default(false)
  collectionType CollectionType @default(MANGA)
  note           Float?         @map("rating")
  genre          String?
  coverUrl       String?

  userId String
  catalogId String?
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalog CatalogManga? @relation(fields: [catalogId], references: [id], onDelete: SetNull)

  volumeRatings  VolumeRating[]
  chapterRatings ChapterRating[]
  volumes        MangaVolume[]
  reviews        MangaReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name, volume])
  @@index([catalogId])
}

model MangaReview {
  id              String       @id @default(cuid())
  mangaId         String
  userId          String
  rating          Float?
  body            String
  containsSpoilers Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  manga           Manga        @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes           ReviewLike[]
  @@unique([mangaId, userId])
  @@index([mangaId, createdAt])
}

model ReviewLike {
  id        String      @id @default(cuid())
  reviewId String
  userId   String
  createdAt DateTime    @default(now())
  review   MangaReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([reviewId, userId])
}

model MangaRequest {
  id             String         @id @default(cuid())
  title          String
  author         String?
  totalVolumes   Int?
  collectionType CollectionType @default(MANGA)
  coverUrl       String?
  status         RequestStatus  @default(PENDING)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, status])
}

model MangaVolume {
  id        String       @id @default(cuid())
  mangaId   String
  number    Int
  status    VolumeStatus @default(MISSING)
  loanedTo  String?
  loanedAt  DateTime?
  dueDate   DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  manga   Manga           @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  history VolumeHistory[]

  @@unique([mangaId, number])
  @@index([mangaId, status])
}

model VolumeHistory {
  id         String        @id @default(cuid())
  volumeId   String
  fromStatus VolumeStatus?
  toStatus   VolumeStatus
  loanedTo   String?
  dueDate    DateTime?
  changedAt  DateTime      @default(now())

  volume MangaVolume @relation(fields: [volumeId], references: [id], onDelete: Cascade)

  @@index([volumeId, changedAt])
}

model VolumeRating {
  id      String @id @default(cuid())
  mangaId String
  volume  Int
  note    Float

  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@unique([mangaId, volume])
}

model ChapterRating {
  id      String @id @default(cuid())
  mangaId String
  chapter Int
  note    Float

  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@unique([mangaId, chapter])
}
