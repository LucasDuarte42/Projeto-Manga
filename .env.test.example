# PostgreSQL exclusivo para testes E2E. Nunca use o banco de produção.
E2E_DATABASE_URL="postgresql://e2e:e2e@localhost:5432/pinakes_e2e"
NEXTAUTH_SECRET="e2e-only-secret-change-me"
NEXTAUTH_URL="http://127.0.0.1:3000"

# O fluxo E2E não envia e-mails; este valor evita inicializações externas.
RESEND_API_KEY="re_placeholder_for_e2e"
